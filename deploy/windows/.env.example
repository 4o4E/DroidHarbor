# 复制为同目录 .env 后即可启动，无需填写 IP 或传入命令行参数。
# 默认通过 WebRTC 自动协商本机/局域网媒体地址。
# 特殊网络需要覆盖候选地址时才取消下一行注释并填写。
# DROIDHARBOR_RTC_ADVERTISED_IP=192.168.1.100

# HTTP 服务与 WebRTC UDP 监听；不需要证书、域名或 origin 配置。
DROIDHARBOR_LISTEN=0.0.0.0:8080
DROIDHARBOR_RTC_LISTEN=0.0.0.0:8081

# 外部已运行的 ADB Server；平台不会启动或替换它。
DROIDHARBOR_ADB_SERVER=127.0.0.1:5037

# 相对路径均相对于此 .env 文件所在目录。
DROIDHARBOR_DATABASE=data/droidharbor.db
DROIDHARBOR_ADMIN_FILE=data/admin.json
DROIDHARBOR_TRANSFER_TEMP_DIR=data/transfers
DROIDHARBOR_LOG_FILE=logs/platform.jsonl
DROIDHARBOR_LOG_LEVEL=info
